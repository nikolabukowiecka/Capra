Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Signal", " ", "consistency", " ", "diagnostics"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toZero", "[", "x_", "]"}], ":=", 
     RowBox[{"x", "/.", " ", 
      RowBox[{"Null", "->", "0."}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"domega", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pi", "/", 
       RowBox[{"(", 
        RowBox[{"3", "*", 
         RowBox[{"tesselation", "^", "2"}]}], ")"}]}], "*", "1."}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sig", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataSignal", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exp", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataExp", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cts", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataCts", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rates", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataRates", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", "=", 
     RowBox[{"N", "@", "domega"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Expected", " ", "rates"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"expectedRates", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "0."}], ",", "0.", ",", 
         RowBox[{
          RowBox[{"sig", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"exp", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ")"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "exp", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{"rates", "-", "expectedRates"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Global", " ", "integrals"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalSig", "=", 
     RowBox[{"Total", "[", "sig", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totalMapSig", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"rates", "*", "exp"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"totalSig", "==", "0."}], ",", "1.", ",", 
       RowBox[{"totalMapSig", "/", "totalSig"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"den", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"exp", "*", "\[CapitalOmega]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rsig", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"den", "==", "0."}], ",", "0.", ",", 
       RowBox[{"totalSig", "*", 
        RowBox[{"\[CapitalOmega]", "/", "den"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Rmap", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"den", "==", "0."}], ",", "0.", ",", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"rates", "*", "exp", "*", "\[CapitalOmega]"}], "]"}], "/", 
        "den"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Signal", " ", "reconstruction", " ", 
     RowBox[{"(", 
      RowBox[{"signal", "\[TildeTilde]", 
       RowBox[{"rates", "*", "exp"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"signalRecon", "=", 
     RowBox[{"rates", "*", "exp"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"signalDiff", "=", 
     RowBox[{"Chop", "[", 
      RowBox[{
       RowBox[{"Total", "[", "signalRecon", "]"}], "-", 
       RowBox[{"Total", "[", "sig", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"ROI", " ", "stability", " ", 
     RowBox[{"(", 
      RowBox[{"brightest", " ", "5", "%"}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"q95", "=", 
     RowBox[{"Quantile", "[", 
      RowBox[{
       RowBox[{"DeleteCases", "[", 
        RowBox[{"rates", ",", 
         RowBox[{"Null", "|", "0."}]}], "]"}], ",", "0.95"}], "]"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"roi", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"q95", "==", "0."}], "||", 
        RowBox[{"q95", ">", 
         RowBox[{"Max", "[", 
          RowBox[{"DeleteCases", "[", 
           RowBox[{"rates", ",", 
            RowBox[{"Null", "|", "0."}]}], "]"}], "]"}]}]}], ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{"no", " ", "valid", " ", "ROI"}], "*)"}], 
       RowBox[{"Flatten", "@", 
        RowBox[{"Position", "[", 
         RowBox[{"rates", ",", 
          RowBox[{"_", "?", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#", ">", "q95"}], "&"}], ")"}]}]}], "]"}]}]}], "]"}]}], 
    ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rroi", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"roi", "===", 
         RowBox[{"{", "}"}]}], "||", 
        RowBox[{
         RowBox[{"Total", "[", 
          RowBox[{"exp", "[", 
           RowBox[{"[", "roi", "]"}], "]"}], "]"}], "==", "0."}]}], ",", "0.",
        ",", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{
          RowBox[{"rates", "[", 
           RowBox[{"[", "roi", "]"}], "]"}], "*", 
          RowBox[{"exp", "[", 
           RowBox[{"[", "roi", "]"}], "]"}]}], "]"}], "/", 
        RowBox[{"Total", "[", 
         RowBox[{"exp", "[", 
          RowBox[{"[", "roi", "]"}], "]"}], "]"}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Diagnostic", " ", "table"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"diagnostics", "=", 
     RowBox[{"<|", 
      RowBox[{
       RowBox[{"\"\<Tessellation\>\"", "->", "tesselation"}], ",", 
       RowBox[{"\"\<Energy step\>\"", "->", "energyStep"}], ",", 
