Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapHP", "=", 
   RowBox[{"Normal", "@", "mapGDFGrid"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapIb", "=", 
   RowBox[{"Normal", "@", "mapIbexGDF"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"offMask", "=", 
   RowBox[{"calcOffMaskGrid", "[", 
    RowBox[{"mapFluxGrid", ",", "lonGrid", ",", "latGrid"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"offMask", "=", 
    RowBox[{"Normal", "@", "offMask"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"linFit", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "@", "mapHP"}], "/.", " ", 
          RowBox[{"Null", "->", "0"}]}], ",", 
         RowBox[{
          RowBox[{"Flatten", "@", "mapIb"}], "/.", " ", 
          RowBox[{"Null", "->", "0"}]}]}], " ", "}"}]}], ",", "x", ",", "x"}],
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Ensure", " ", "dimensions", " ", "really", " ", "match"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Dimensions", "@", "mapHP"}], "=!=", 
       RowBox[{"Dimensions", "@", "mapIb"}]}], "||", 
      RowBox[{
       RowBox[{"Dimensions", "@", "mapHP"}], "=!=", 
       RowBox[{"Dimensions", "@", "offMask"}]}]}], ",", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<ERROR: Dimensions do not match\>\"", "]"}], ";", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Flatten", " ", "all", " ", 
    RowBox[{"arrays", ":", 
     RowBox[{
     "now", " ", "each", " ", "must", " ", "have", " ", "exactly", " ", 
      "1800", " ", "elements"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hpFlat", "=", 
   RowBox[{"Flatten", "@", "mapHP"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thesFlat", "=", 
   RowBox[{"Flatten", "@", "mapIb"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maskFlat", "=", 
    RowBox[{"Flatten", "@", "offMask"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Check", " ", "integrity"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "hpFlat"}], "=!=", 
       RowBox[{"Length", "@", "thesFlat"}]}], "||", 
      RowBox[{
       RowBox[{"Length", "@", "hpFlat"}], "=!=", 
       RowBox[{"Length", "@", "maskFlat"}]}]}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<ERROR: Flattened lengths mismatch\>\"", "]"}], ";", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Build", " ", "masks", " ", "for", " ", "valid", " ", 
     RowBox[{"(", "numeric", ")"}], " ", "and", " ", "off"}], "-", 
    RowBox[{"ribbon", " ", "pixels"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"validMaskFlat", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", "#1", "]"}], "&&", 
        RowBox[{"NumericQ", "[", "#2", "]"}]}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"hpFlat", ",", "thesFlat"}], "}"}]}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"offValidMaskFlat", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "&&", "#2"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"validMaskFlat", ",", "maskFlat"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "pixel", " ", "lists", " ", "for", " ", "statistics"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valsHPall", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"hpFlat", ",", "validMaskFlat"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valsThesall", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"thesFlat", ",", "validMaskFlat"}], "]"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valsHPoff", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"hpFlat", ",", "offValidMaskFlat"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valsThesoff", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"thesFlat", ",", "offValidMaskFlat"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "RMSE", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"global", "&"}], " ", "off"}], "-", "ribbon"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rmseAll", "=", 
   RowBox[{"Sqrt", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"valsThesall", "-", "valsHPall"}], ")"}], "^", "2"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmseOff", "=", 
    RowBox[{"Sqrt", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"valsThesoff", "-", "valsHPoff"}], ")"}], "^", "2"}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "correlation", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"global", "&"}], " ", "off"}], "-", "ribbon"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corrAll", "=", 
   RowBox[{"Correlation", "[", 
    RowBox[{"valsHPall", ",", "valsThesall"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"corrOff", "=", 
    RowBox[{"Correlation", "[", 
     RowBox[{"valsHPoff", ",", "valsThesoff"}], "]"}]}], ";"}], "\n", "\n", 
  RowBox[{"(*", 
   RowBox[{"Print", " ", "nicely"}], "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Global corr: \>\"", ",", "corrAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Off-ribbon corr: \>\"", ",", "corrOff"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<BestFitParameters\>\"", ",", 
    RowBox[{"NumberForm", "[", 
     RowBox[{"linFit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"Print", "[", 
    RowBox[{"\"\<R\.b2 = \>\"", ",", 
     RowBox[{"NumberForm", "[", 
      RowBox[{"linFit", "[", "\"\<RSquared\>\"", "]"}], "]"}]}], "]"}], ";"}],
   "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Global RMSE: \>\"", ",", "rmseAll"}], "]"}], ";", "\n", 
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Off-ribbon RMSE: \>\"", ",", "rmseOff"}], "]"}], ";"}], 
   "*)"}]}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.972168797239574*^9, 3.972168811845887*^9}, {
   3.9721689530182333`*^9, 3.972168962354341*^9}, {3.972429671149873*^9, 
