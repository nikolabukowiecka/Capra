Cell["Postprocessing ", "Section",
 CellChangeTimes->{{3.970058573103847*^9, 3.9700585837674503`*^9}, {
  3.970782305227364*^9, 3.970782305552692*^9}, {3.9713812533332853`*^9, 
  3.971381257267901*^9}},ExpressionUUID->"e5d93c55-49c8-491d-8be7-\
797b9f9ab7a8"],

Cell["\<\
Part 0 - change to grid; not post-processed
Part 1 - change to grid; relative -> What is each rectangular map relative to \
its own area-weighted mean on the comparison grid?
Part 2 - change to grid; GDF flux\
\>", "Text",
 CellChangeTimes->{{3.986582317717021*^9, 3.986582341713978*^9}, {
  3.9869240221417522`*^9, 
  3.9869240236198874`*^9}},ExpressionUUID->"b3a7ac75-4c2e-4f6a-ac70-\
1ce859275a19"],

Cell["\<\
Types of means:
- native mean: average over native HEALPix/binned pixels
- source-conserved remap mean: average over source pixels after grouping into \
rectangular cells (Each target-cell value is weighted by the number of HP \
pixels that contributed to it) 
- painted (observed) target mean: average over the rectangular grid after \
painting (observing) (Each rectangular target cell is weighted by its ideal \
target-cell solid angle, not by how many HP pixels actually landed in it)\
\>", "Text",
 CellChangeTimes->{{3.9869237056416273`*^9, 3.986923870932843*^9}, {
  3.986923903234667*^9, 3.986923909331092*^9}, {3.986997895701994*^9, 
  3.98699790348652*^9}},ExpressionUUID->"7ca104e6-4f4a-40f5-8670-\
6cb86dcd94dc"],

