Cell[BoxData[{
 RowBox[{
  RowBox[{"valsESA", "=", 
   RowBox[{"DeleteCases", "[", 
    RowBox[{
     RowBox[{"Flatten", "@", "mapGDFThesHP"}], ",", 
     RowBox[{
      RowBox[{"_", "?", 
       RowBox[{"(", 
        RowBox[{"Not", "@*", "NumericQ"}], ")"}]}], "|", "Null"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{"{", 
  RowBox[{
   RowBox[{"Min", "[", "valsESA", "]"}], ",", 
   RowBox[{"Max", "[", "valsESA", "]"}], ",", 
