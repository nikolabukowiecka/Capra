Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"GDF", " ", "flux", " ", "map"}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"mapGDFThesHP", "=", 
     RowBox[{"normalizeGDF", "[", 
      RowBox[{
      "hpFluxFinal", ",", "hpExp", ",", "tesselation", ",", "energyStep", ",", 
       RowBox[{"\"\<PsiCut\>\"", "->", "30."}], ",", 
