Cell[CellGroupData[{

Cell["Pearson correlation", "Subsubsection",
 CellChangeTimes->{{4.000571855968912*^9, 
  4.000571859946641*^9}},ExpressionUUID->"479a7334-5d85-4f3d-8dc1-\
7c99ddefc94d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"pixel", "-", 
    RowBox[{
    "wise", " ", "correlation", " ", "of", " ", "Capra", " ", "with", " ", 
     "THESEUS", " ", "and", " ", "IBEX", " ", "on", " ", "the", " ", "6", 
     "x6", " ", "deg", " ", "grid"}]}], "*)"}], "\n", 
  RowBox[{
   RowBox[{
    RowBox[{"dir", "=", 
     RowBox[{"FileNameJoin", "[", 
      RowBox[{"baseDir", ",", 
       RowBox[{"{", 
        RowBox[{"\"\<output\>\"", ",", "\"\<Gaussian_v2\>\"", 
         ",", "\"\<Part0\>\""}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"readGrid", "[", "f_", "]"}], ":=", 
     RowBox[{"Map", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"NumberQ", "[", "#", "]"}], ",", 
          RowBox[{"N", "[", "#", "]"}], ",", "Null"}], "]"}], "&"}], ",", 
       RowBox[{"Import", "[", 
        RowBox[{
         RowBox[{"FileNameJoin", "[", 
          RowBox[{"{", 
           RowBox[{"dir", ",", "f"}], "}"}], "]"}], ",", "\"\<TSV\>\""}], 
        "]"}], ",", 
       RowBox[{"{", "2", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nR", ",", "nC"}], "}"}], "=", 
     RowBox[{"{", 
      RowBox[{"30", ",", "60"}], "}"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"lonG", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"(", 
         RowBox[{"c", "-", 
          RowBox[{"1", "/", "2"}]}], ")"}], " ", 
        RowBox[{"360.", "/", "nC"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "nR"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "nC"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"latG", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"90", "-", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"r", "-", 
           RowBox[{"1", "/", "2"}]}], ")"}], " ", 
         RowBox[{"180.", "/", "nR"}]}]}], ",", 
       RowBox[{"{", 
        RowBox[{"r", ",", "nR"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "nC"}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"wG", "=", 
     RowBox[{"Flatten", "@", 
      RowBox[{"Cos", "[", 
       RowBox[{"latG", " ", "Degree"}], "]"}]}]}], ";"}], 
   "                          ", 
   RowBox[{"(*", 
    RowBox[{"cell", " ", "solid", " ", 
     RowBox[{"angle", "~", "cos"}], 
     RowBox[{"(", "latitude", ")"}]}], "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"wCorr", "[", 
      RowBox[{"x_", ",", "y_", ",", "w_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"mx", "=", 
          RowBox[{
           RowBox[{"w", ".", "x"}], "/", 
           RowBox[{"Total", "[", "w", "]"}]}]}], ",", 
         RowBox[{"my", "=", 
          RowBox[{
           RowBox[{"w", ".", "y"}], "/", 
           RowBox[{"Total", "[", "w", "]"}]}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"w", ".", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"x", "-", "mx"}], ")"}], " ", 
            RowBox[{"(", 
             RowBox[{"y", "-", "my"}], ")"}]}], ")"}]}], ")"}], "/", 
        RowBox[{"Sqrt", "[", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{"w", ".", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"x", "-", "mx"}], ")"}], "^", "2"}]}], ")"}], " ", 
          RowBox[{"(", 
           RowBox[{"w", ".", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"y", "-", "my"}], ")"}], "^", "2"}]}], ")"}]}], 
         "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{
     RowBox[{"corrESA", "[", "esa_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"hp", ",", "mask", ",", 
         RowBox[{"row", "=", 
          RowBox[{"{", "esa", "}"}]}]}], "}"}], ",", 
       RowBox[{
        RowBox[{"hp", "=", 
         RowBox[{"Flatten", "@", 
          RowBox[{"readGrid", "[", 
           RowBox[{"\"\<HP-rawFlux_64_\>\"", "<>", 
            RowBox[{"ToString", "[", "esa", "]"}], 
            "<>", "\"\<_30_60.txt\>\""}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"mask", "=", 
         RowBox[{"Flatten", "@", 
          RowBox[{"calcOffMaskGrid", "[", 
           RowBox[{
            RowBox[{"Partition", "[", 
             RowBox[{"hp", ",", "nC"}], "]"}], ",", "lonG", ",", "latG", ",", 
            
            RowBox[{"\"\<PsiCut\>\"", "->", "30."}], ",", 
            RowBox[{"\"\<NoseTailCut\>\"", "->", "30."}], ",", 
            RowBox[{"\"\<FluxPercentile\>\"", "->", ".70"}], ",", 
            RowBox[{"\"\<RibbonFitPercentile\>\"", "->", ".85"}]}], "]"}]}]}],
         ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Module", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"o", ",", "ok", ",", "off", ",", "pick"}], "}"}], ",", 
            RowBox[{
             RowBox[{"o", "=", 
              RowBox[{"Flatten", "@", 
               RowBox[{"readGrid", "[", 
                RowBox[{"pre", "<>", 
                 RowBox[{"ToString", "[", "esa", "]"}], 
                 "<>", "\"\<_30_60.txt\>\""}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"ok", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{
                  RowBox[{"NumberQ", "[", "#1", "]"}], "&&", 
                  RowBox[{"NumberQ", "[", "#2", "]"}]}], "&"}], ",", 
                RowBox[{"{", 
                 RowBox[{"hp", ",", "o"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"off", "=", 
              RowBox[{"MapThread", "[", 
               RowBox[{"And", ",", 
                RowBox[{"{", 
                 RowBox[{"ok", ",", "mask"}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"pick", "[", "m_", "]"}], ":=", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"Pick", "[", 
                 RowBox[{"hp", ",", "m"}], "]"}], ",", 
                RowBox[{"Pick", "[", 
                 RowBox[{"o", ",", "m"}], "]"}], ",", 
                RowBox[{"Pick", "[", 
                 RowBox[{"wG", ",", "m"}], "]"}]}], "}"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"row", "=", 
              RowBox[{"Join", "[", 
               RowBox[{"row", ",", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"Count", "[", 
                   RowBox[{"ok", ",", "True"}], "]"}], ",", 
                  RowBox[{"Correlation", "@@", 
                   RowBox[{"Most", "[", 
                    RowBox[{"pick", "[", "ok", "]"}], "]"}]}], ",", 
                  RowBox[{"wCorr", "@@", 
                   RowBox[{"pick", "[", "ok", "]"}]}], ",", 
                  RowBox[{"Count", "[", 
                   RowBox[{"off", ",", "True"}], "]"}], ",", 
                  RowBox[{"Correlation", "@@", 
                   RowBox[{"Most", "[", 
                    RowBox[{"pick", "[", "off", "]"}], "]"}]}], ",", 
                  RowBox[{"wCorr", "@@", 
                   RowBox[{"pick", "[", "off", "]"}]}]}], "}"}]}], 
               "]"}]}]}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"pre", ",", 
            RowBox[{"{", 
             RowBox[{"\"\<THES-rawFlux_\>\"", ",", "\"\<IBEX-rawFlux_\>\""}], 
             "}"}]}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", "row"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"TableForm", "[", 
    RowBox[{
     RowBox[{"corrESA", "/@", 
      RowBox[{"Range", "[", 
       RowBox[{"2", ",", "6"}], "]"}]}], ",", 
     RowBox[{"TableHeadings", "->", 
      RowBox[{"{", 
       RowBox[{"None", ",", 
        RowBox[{"{", 
         RowBox[{"\"\<ESA\>\"", ",", "\"\<n\>\"", ",", "\"\<\[Rho] THES\>\"", 
          ",", "\"\<\[Rho]w THES\>\"", ",", "\"\<n off\>\"", 
          ",", "\"\<\[Rho] off\>\"", ",", "\"\<\[Rho]w off\>\"", 
          ",", "\"\<n\>\"", ",", "\"\<\[Rho] IBEX\>\"", 
          ",", "\"\<\[Rho]w IBEX\>\"", ",", "\"\<n off\>\"", 
          ",", "\"\<\[Rho] off\>\"", ",", "\"\<\[Rho]w off\>\""}], "}"}]}], 
       "}"}]}]}], "]"}]}]}]], "Input",
 CellChangeTimes->{{4.0005718612711163`*^9, 4.0005718887459307`*^9}, {
  4.000571932920409*^9, 4.000571934657868*^9}, {4.0005721272151613`*^9, 
