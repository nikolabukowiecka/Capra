  3.972168265803001*^9}},ExpressionUUID->"5cfde7df-da3c-4894-9ecf-\
1c61a889f987"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapGDF", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<HP-GDF_16_6.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapGDFThesHP", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<Thes-HP-GDF_16_6.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9796441440122967`*^9, 3.9796441880365057`*^9}, {
  3.9796442303050127`*^9, 3.979644243238327*^9}, {3.9796447526693*^9, 
  3.979644754332657*^9}, {3.979644822796013*^9, 3.979644824837283*^9}, {
  3.9796448605423613`*^9, 3.9796448626480303`*^9}, {3.979644900576284*^9, 
  3.97964490237199*^9}},
 CellLabel->
  "In[169]:=",ExpressionUUID->"17f94e4a-4bf5-47b4-bbea-4b4526cae386"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"mapHP", "=", 
    RowBox[{"Flatten", "@", "mapGDF"}]}], ";"}], "        ", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "HP"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"mapThes", "=", 
    RowBox[{"Flatten", "@", "mapGDFThesHP"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"from", " ", "Theseus"}], "*)"}]}]}], "Input",
 CellChangeTimes->{{3.972164494792605*^9, 3.972164512070381*^9}, {
   3.9721685721689787`*^9, 3.972168593513102*^9}, {3.972168652914364*^9, 
   3.972168659312488*^9}, {3.9721687049087553`*^9, 3.9721687183198147`*^9}, {
   3.97216880063615*^9, 3.972168801162034*^9}, 3.9724305947878838`*^9, {
   3.9724344701994877`*^9, 3.972434471799547*^9}, 3.9724345665281267`*^9, {
   3.9796446485135508`*^9, 3.979644653241583*^9}},
 CellLabel->
  "In[171]:=",ExpressionUUID->"ad1a448c-fe40-475a-a282-b7b190fbba60"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"thresh", "=", 
    RowBox[{"Quantile", "[", 
     RowBox[{
      RowBox[{"DeleteCases", "[", 
       RowBox[{
        RowBox[{"Flatten", "@", "mapHP"}], ",", 
        RowBox[{"Null", "|", 
         RowBox[{"_", "?", 
          RowBox[{"(", 
           RowBox[{"Not", "@*", "NumericQ"}], ")"}]}]}]}], "]"}], ",", 
      "0.80"}], "]"}]}], ";"}], "  ", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"~", "80"}], "%", " ", "of", " ", "sky", " ", "is", " ", "off"}],
     "-", "ribbon"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"offMask", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
         RowBox[{"#", "<", "thresh"}]}], ",", "True", ",", "False"}], "]"}], 
      "&"}], ",", "mapHP"}], "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9721692185992947`*^9, 3.9721692202267303`*^9}, {
  3.972430668267902*^9, 3.9724306695130043`*^9}},
 CellLabel->
  "In[173]:=",ExpressionUUID->"0c516fb7-8aae-4009-b355-ed3cce21016f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"linFit", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "@", "mapHP"}], "/.", " ", 
          RowBox[{"Null", "->", "0"}]}], ",", 
         RowBox[{
          RowBox[{"Flatten", "@", "mapThes"}], "/.", " ", 
          RowBox[{"Null", "->", "0"}]}]}], " ", "}"}]}], ",", "x", ",", "x"}],
      "]"}]}], ";"}], "\[IndentingNewLine]"}]], "Input",
 CellChangeTimes->{{3.979644276564918*^9, 3.979644279929205*^9}},
 CellLabel->
  "In[175]:=",ExpressionUUID->"6d1b8679-c434-4610-a9d0-3f7928e41473"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"validMask", "=", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"NumericQ", "[", "#1", "]"}], "&&", 
       RowBox[{"NumericQ", "[", "#2", "]"}]}], "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"mapHP", ",", "mapThes"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"offMask", "=", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"NumericQ", "[", "#", "]"}], "&&", 
         RowBox[{"#", "<", "1.5"}]}], ",", "True", ",", "False"}], "]"}], 
      "&"}], ",", "mapHP"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"offValidMask", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "&&", "#2"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"validMask", ",", "offMask"}], "}"}]}], "]"}]}], ";"}], 
  "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valsHPall", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"mapHP", ",", "validMask"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valsThesall", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"mapThes", ",", "validMask"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"valsHPoff", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"mapHP", ",", "offValidMask"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"valsThesoff", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"mapThes", ",", "offValidMask"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"rmseAll", "=", 
   RowBox[{"Sqrt", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"valsThesall", "-", "valsHPall"}], ")"}], "^", "2"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmseOff", "=", 
    RowBox[{"Sqrt", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"valsThesoff", "-", "valsHPoff"}], ")"}], "^", "2"}], 
      "]"}]}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corrAll", "=", 
   RowBox[{"Correlation", "[", 
    RowBox[{"valsHPall", ",", "valsThesall"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"corrOff", "=", 
    RowBox[{"Correlation", "[", 
     RowBox[{"valsHPoff", ",", "valsThesoff"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Global corr: \>\"", ",", "corrAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Off-ribbon corr: \>\"", ",", "corrOff"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<BestFitParameters\>\"", ",", 
    RowBox[{"NumberForm", "[", 
     RowBox[{"linFit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<R\.b2 = \>\"", ",", 
    RowBox[{"NumberForm", "[", 
     RowBox[{"linFit", "[", "\"\<RSquared\>\"", "]"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Global RMS: \>\"", ",", "rmseAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Off-ribbon RMS: \>\"", ",", "rmseOff"}], "]"}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.972169126650565*^9, 3.9721691266523237`*^9}, {
