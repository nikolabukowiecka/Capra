Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{"Global", " ", "consistency", " ", "diagnostics"}], "*)"}]], "Input",\

 CellLabel->
  "In[2880]:=",ExpressionUUID->"7a0effb4-a624-437b-94ac-2910be6f8ce9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Signal", " ", "consistency", " ", "diagnostics"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"toZero", "[", "x_", "]"}], ":=", 
     RowBox[{"x", "/.", " ", 
      RowBox[{"Null", "->", "0."}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"domega", " ", "=", " ", 
     RowBox[{
      RowBox[{"Pi", "/", 
       RowBox[{"(", 
        RowBox[{"3", "*", 
         RowBox[{"tesselation", "^", "2"}]}], ")"}]}], "*", "1."}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"sig", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataSignal", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"exp", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataExp", "]"}]}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"cts", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataCts", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"rates", "=", 
     RowBox[{"N", "@", 
      RowBox[{"toZero", "[", "dataRates", "]"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[CapitalOmega]", "=", 
     RowBox[{"N", "@", "domega"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Expected", " ", "rates"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"expectedRates", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"exp", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "0."}], ",", "0.", ",", 
         RowBox[{
          RowBox[{"sig", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
          RowBox[{"(", 
           RowBox[{"exp", "[", 
            RowBox[{"[", "i", "]"}], "]"}], ")"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", 
         RowBox[{"Length", "[", "exp", "]"}]}], "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"diff", "=", 
     RowBox[{"rates", "-", "expectedRates"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Global", " ", "integrals"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"totalSig", "=", 
     RowBox[{"Total", "[", "sig", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"totalMapSig", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"rates", "*", "exp"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"K", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"totalSig", "==", "0."}], ",", "1.", ",", 
       RowBox[{"totalMapSig", "/", "totalSig"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"den", "=", 
     RowBox[{"Total", "[", 
      RowBox[{"exp", "*", "\[CapitalOmega]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Rsig", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"den", "==", "0."}], ",", "0.", ",", 
       RowBox[{"totalSig", "*", 
        RowBox[{"\[CapitalOmega]", "/", "den"}]}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"Rmap", "=", 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"den", "==", "0."}], ",", "0.", ",", 
       RowBox[{
        RowBox[{"Total", "[", 
         RowBox[{"rates", "*", "exp", "*", "\[CapitalOmega]"}], "]"}], "/", 
        "den"}]}], "]"}]}], ";"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Signal", " ", "reconstruction", " ", 
     RowBox[{"(", 
      RowBox[{"signal", "\[TildeTilde]", 
       RowBox[{"rates", "*", "exp"}]}], ")"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"signalRecon", "=", 
