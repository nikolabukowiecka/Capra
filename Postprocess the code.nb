Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"offMaskThesGrid", "=", 
    RowBox[{"calcOffMaskGrid", "[", 
     RowBox[{"mapThesFlux", ",", "lonGrid", ",", "latGrid", ",", 
      RowBox[{"\"\<PsiCut\>\"", "->", "30."}], ",", 
      RowBox[{"\"\<NoseTailCut\>\"", "->", "30."}], ",", 
      RowBox[{"\"\<FluxPercentile\>\"", "->", ".70"}], ",", 
      RowBox[{"\"\<RibbonFitPercentile\>\"", "->", ".85"}]}], "]"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"mapThesGDF", "=", 
