Cell[BoxData[{
 RowBox[{
  RowBox[{"nRows", "=", 
   RowBox[{"resolution", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"nCols", "=", 
    RowBox[{"resolution", "[", 
     RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"dtheta", "=", 
   RowBox[{"180.", "/", "nRows"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dphi", "=", 
    RowBox[{"360.", "/", "nCols"}]}], ";"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lonGrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"c", "-", 
        RowBox[{"1", "/", "2"}]}], ")"}], " ", "dphi"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "nRows"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "nCols"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"latGrid", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"90", "-", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"r", "-", 
         RowBox[{"1", "/", "2"}]}], ")"}], " ", "dtheta"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "nRows"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"c", ",", "nCols"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
