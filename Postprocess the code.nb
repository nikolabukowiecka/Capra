Cell["Theseus data", "Subsubsection",
 CellChangeTimes->{{3.970789716702457*^9, 
  3.970789719277947*^9}},ExpressionUUID->"878ea0c5-c43e-4565-aedf-\
da9700d3049f"],

Cell["a) Theseus -> HP grid ", "Text",
 CellChangeTimes->{{3.972162433113339*^9, 
  3.972162451239996*^9}},ExpressionUUID->"c39790f2-91be-424c-89bc-\
53a43ff40937"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"colat", "/", "lon"}], " ", "to", " ", "rad"}], "*)"}], 
  "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"theta", "=", 
     RowBox[{"colatThes", " ", "Degree"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"phi", "=", 
     RowBox[{"Mod", "[", 
      RowBox[{
       RowBox[{"longThes", " ", "Degree"}], ",", 
       RowBox[{"2", " ", "Pi"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "HP", " ", "index", " ", "for", " ", "each", " ", "data", " ", "point"}], 
    "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"pixIndex", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"healpix`fun`ang2pixRing", "[", 
         RowBox[{"tesselation", ",", "#1", ",", "#2"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"theta", ",", "phi"}], "}"}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"HP", " ", "arrays"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"npix", "=", 
     RowBox[{"12", "*", 
      RowBox[{"tesselation", "^", "2"}]}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hpFlux", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "npix"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"hpExp", "=", 
     RowBox[{"ConstantArray", "[", 
      RowBox[{"0.", ",", "npix"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", 
   RowBox[{"(*", 
    RowBox[{"Accumulate", " ", "weighted", " ", "flux"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"Do", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"hpFlux", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"pixIndex", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], "]"}], "]"}], "+=", 
        RowBox[{
         RowBox[{"fluxThes", "[", 
          RowBox[{"[", "i", "]"}], "]"}], "*", 
         RowBox[{"expThes", "[", 
          RowBox[{"[", "i", "]"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"hpExp", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"pixIndex", "[", 
            RowBox[{"[", "i", "]"}], "]"}], "+", "1"}], "]"}], "]"}], "+=", 
        RowBox[{"expThes", "[", 
         RowBox[{"[", "i", "]"}], "]"}]}], ";"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", 
        RowBox[{"Length", "[", "pixIndex", "]"}]}], "}"}]}], "]"}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"HP", " ", "flux", " ", "map"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hpFluxFinal", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"hpExp", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "==", "0"}], ",", "Null", ",", 
         RowBox[{
          RowBox[{"hpFlux", "[", 
           RowBox[{"[", "i", "]"}], "]"}], "/", 
          RowBox[{"hpExp", "[", 
           RowBox[{"[", "i", "]"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "npix"}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.972162883798126*^9, 3.972162892191667*^9}, {
  3.972481763511092*^9, 3.97248179159939*^9}, {3.9869903937145653`*^9, 
  3.9869903944259872`*^9}},
 CellLabel->
