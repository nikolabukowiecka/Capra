 CellChangeTimes->{3.989518834933724*^9},
 CellLabel->
  "In[1500]:=",ExpressionUUID->"f9bbcf6a-d13a-4f33-a9dc-8a62c36016a1"],

Cell["\<\
Types of means:
- native mean: average over native HEALPix/binned pixels
- source-conserved remap mean: average over source pixels after grouping into \
rectangular cells (Each target-cell value is weighted by the number of HP \
pixels that contributed to it) 
- painted (observed) target mean: average over the rectangular grid after \
painting (observing) (Each rectangular target cell is weighted by its ideal \
target-cell solid angle, not by how many HP pixels actually landed in it)\
\>", "Text",
 CellChangeTimes->{{3.9869237056416273`*^9, 3.986923870932843*^9}, {
  3.986923903234667*^9, 3.986923909331092*^9}, {3.986997895701994*^9, 
