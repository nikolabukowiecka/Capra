Cell["Compare HP and IBEX in Grid framework", "Subsubsection",
 CellChangeTimes->{{3.972164489683563*^9, 3.972164493448003*^9}, {
  3.972168260879846*^9, 3.972168265803001*^9}, {3.972168465823064*^9, 
  3.97216846623029*^9}, {3.9724297461182137`*^9, 
  3.97242974662663*^9}},ExpressionUUID->"703e324d-2664-43df-bc74-\
c27d086eb088"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapGDFGrid", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<normalizedHP-GDF_64_\>\"", "<>", 
       RowBox[{"ToString", "[", "energyStep", "]"}], 
       "<>", "\"\<_30_60.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapIbexGDF", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<Ibex-GDF_16_\>\"", "<>", 
       RowBox[{"ToString", "[", "energyStep", "]"}], 
       "<>", "\"\<_30_60.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapFluxGrid", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], "<>", "\"\<HP-_64_\>\"",
        "<>", 
       RowBox[{"ToString", "[", "energyStep", "]"}], 
       "<>", "\"\<_30_60.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9796399479883547`*^9, 3.9796399943454123`*^9}, {
  3.979640154094129*^9, 3.979640165306431*^9}, {3.979640276440517*^9, 
  3.979640293973631*^9}, {3.979640335905933*^9, 3.979640394142398*^9}, {
  3.980445614158462*^9, 3.980445614533617*^9}, {3.980446215959695*^9, 
  3.980446218908309*^9}, {3.98044626880655*^9, 3.9804462722440166`*^9}, {
