Cell[BoxData[
 RowBox[{"Table", "[", 
  RowBox[{
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"mask", ",", "baseline", ",", "gdf"}], "}"}], ",", 
     RowBox[{
      RowBox[{"gdf", "=", 
       RowBox[{"normalizeGDF", "[", 
        RowBox[{
        "dataENAFlux", ",", "dataExp", ",", "tesselation", ",", "energyStep", 
         ",", 
         RowBox[{"\"\<PsiCut\>\"", "->", "psi"}], ",", 
         RowBox[{"\"\<NoseTailCut\>\"", "->", "30."}], ",", 
         RowBox[{"\"\<FluxPercentile\>\"", "->", ".70"}], ",", 
         RowBox[{"\"\<RibbonFitPercentile\>\"", "->", ".85"}], ",", 
         RowBox[{"\"\<PrintDiagnostics\>\"", "->", "False"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"mask", "=", 
       RowBox[{"calcOffMask", "[", 
        RowBox[{"dataENAFlux", ",", "dataExp", ",", 
         RowBox[{"\"\<PsiCut\>\"", "->", "psi"}], ",", 
         RowBox[{"\"\<NoseTailCut\>\"", "->", "30."}], ",", 
         RowBox[{"\"\<FluxPercentile\>\"", "->", ".70"}], ",", 
         RowBox[{"\"\<RibbonFitPercentile\>\"", "->", ".85"}]}], "]"}]}], ";",
       "\[IndentingNewLine]", 
      RowBox[{"baseline", "=", 
       RowBox[{"weightedMedian", "[", 
        RowBox[{
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"Flatten", "@", "dataENAFlux"}], ",", "mask", ",", 
           "True"}], "]"}], ",", 
         RowBox[{"Pick", "[", 
          RowBox[{
           RowBox[{"Flatten", "@", "dataExp"}], ",", "mask", ",", "True"}], 
          "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"psi", ",", 
        RowBox[{"Count", "[", 
         RowBox[{"mask", ",", "True"}], "]"}], ",", "baseline"}], "}"}]}]}], 
    "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"psi", ",", 
