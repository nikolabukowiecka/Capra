Cell[CellGroupData[{

Cell["Compare HP and Theseus in Grid framework", "Subsubsection",
 CellChangeTimes->{{3.972164489683563*^9, 3.972164493448003*^9}, {
  3.972168260879846*^9, 3.972168265803001*^9}, {3.972168465823064*^9, 
  3.97216846623029*^9}},ExpressionUUID->"b6302395-e0cb-4593-a564-\
da4c8dad31b9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapGDFGrid", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<normalizedHP-GDF_64_4_30_60.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapThesGDF", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<Theseus-GDF_16_4_30_60.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mapFluxGrid", "=", 
   RowBox[{
    RowBox[{"Import", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"ToFileName", "[", "outputDir", "]"}], 
       "<>", "\"\<HP-_64_4_30_60.txt\>\""}], ",", 
      RowBox[{"{", "\"\<Data\>\"", "}"}]}], "]"}], "/.", " ", 
    RowBox[{
     RowBox[{"Missing", "[", "\"\<NotAvailable\>\"", "]"}], "->", 
     "Null"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.979643637717491*^9, 3.9796436500331097`*^9}, {
  3.979643681009419*^9, 3.979643689637247*^9}, {3.9796438019519253`*^9, 
  3.979643805210701*^9}, {3.979643860344245*^9, 3.9796438644292192`*^9}, {
  3.979643897240362*^9, 3.979643900694129*^9}, {3.9796439423525352`*^9, 
  3.979643946334146*^9}, {3.980447682279148*^9, 3.980447687590996*^9}, {
  3.980447724926072*^9, 3.980447728156281*^9}},
 CellLabel->
  "In[193]:=",ExpressionUUID->"2136a695-2400-4bea-9554-58b908724994"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"mapHP", "=", 
   RowBox[{"Normal", "@", "mapGDFGrid"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"mapThes", "=", 
   RowBox[{"Normal", "@", "mapThesGDF"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"offMask", "=", 
   RowBox[{"calcOffMaskGrid", "[", 
    RowBox[{"mapFluxGrid", ",", "lonGrid", ",", "latGrid"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"offMask", "=", 
    RowBox[{"Normal", "@", "offMask"}]}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"linFit", "=", 
    RowBox[{"LinearModelFit", "[", 
     RowBox[{
      RowBox[{"Transpose", "@", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Flatten", "@", "mapHP"}], "/.", " ", 
          RowBox[{"Null", "->", "0"}]}], ",", 
         RowBox[{
          RowBox[{"Flatten", "@", "mapThes"}], "/.", " ", 
          RowBox[{"Null", "->", "0"}]}]}], " ", "}"}]}], ",", "x", ",", "x"}],
      "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Ensure", " ", "dimensions", " ", "really", " ", "match"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Dimensions", "@", "mapHP"}], "=!=", 
       RowBox[{"Dimensions", "@", "mapThes"}]}], "||", 
      RowBox[{
       RowBox[{"Dimensions", "@", "mapHP"}], "=!=", 
       RowBox[{"Dimensions", "@", "offMask"}]}]}], ",", 
     RowBox[{
      RowBox[{"Print", "[", "\"\<ERROR: Dimensions do not match\>\"", "]"}], ";", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{"Flatten", " ", "all", " ", 
    RowBox[{"arrays", ":", 
     RowBox[{
     "now", " ", "each", " ", "must", " ", "have", " ", "exactly", " ", 
      "1800", " ", "elements"}]}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"hpFlat", "=", 
   RowBox[{"Flatten", "@", "mapHP"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"thesFlat", "=", 
   RowBox[{"Flatten", "@", "mapThes"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maskFlat", "=", 
    RowBox[{"Flatten", "@", "offMask"}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Check", " ", "integrity"}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"If", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Length", "@", "hpFlat"}], "=!=", 
       RowBox[{"Length", "@", "thesFlat"}]}], "||", 
      RowBox[{
       RowBox[{"Length", "@", "hpFlat"}], "=!=", 
       RowBox[{"Length", "@", "maskFlat"}]}]}], ",", 
     RowBox[{
      RowBox[{
      "Print", "[", "\"\<ERROR: Flattened lengths mismatch\>\"", "]"}], ";", 
      RowBox[{"Abort", "[", "]"}]}]}], "]"}], ";"}], "\[IndentingNewLine]", 
  "\n", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Build", " ", "masks", " ", "for", " ", "valid", " ", 
     RowBox[{"(", "numeric", ")"}], " ", "and", " ", "off"}], "-", 
    RowBox[{"ribbon", " ", "pixels"}]}], "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"validMaskFlat", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"NumericQ", "[", "#1", "]"}], "&&", 
        RowBox[{"NumericQ", "[", "#2", "]"}]}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"hpFlat", ",", "thesFlat"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"offValidMaskFlat", "=", 
    RowBox[{"MapThread", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#1", "&&", "#2"}], "&"}], ",", 
      RowBox[{"{", 
       RowBox[{"validMaskFlat", ",", "maskFlat"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{
   "Extract", " ", "pixel", " ", "lists", " ", "for", " ", "statistics"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"valsHPall", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"hpFlat", ",", "validMaskFlat"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valsThesall", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"thesFlat", ",", "validMaskFlat"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"valsHPoff", "=", 
   RowBox[{"Pick", "[", 
    RowBox[{"hpFlat", ",", "offValidMaskFlat"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"valsThesoff", "=", 
    RowBox[{"Pick", "[", 
     RowBox[{"thesFlat", ",", "offValidMaskFlat"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "RMSE", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"global", "&"}], " ", "off"}], "-", "ribbon"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rmseAll", "=", 
   RowBox[{"Sqrt", "@", 
    RowBox[{"Mean", "[", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"valsThesall", "-", "valsHPall"}], ")"}], "^", "2"}], 
     "]"}]}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"rmseOff", "=", 
    RowBox[{"Sqrt", "@", 
     RowBox[{"Mean", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"valsThesoff", "-", "valsHPoff"}], ")"}], "^", "2"}], 
      "]"}]}]}], ";"}], "\[IndentingNewLine]", "\n", 
  RowBox[{"(*", 
   RowBox[{"Compute", " ", "correlation", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"global", "&"}], " ", "off"}], "-", "ribbon"}], ")"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corrAll", "=", 
   RowBox[{"Correlation", "[", 
    RowBox[{"valsHPall", ",", "valsThesall"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"corrOff", "=", 
    RowBox[{"Correlation", "[", 
     RowBox[{"valsHPoff", ",", "valsThesoff"}], "]"}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"Print", " ", "nicely"}], "*)"}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Global corr: \>\"", ",", "corrAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Off-ribbon corr: \>\"", ",", "corrOff"}], "]"}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<BestFitParameters\>\"", ",", 
    RowBox[{"NumberForm", "[", 
     RowBox[{"linFit", "[", "\"\<BestFitParameters\>\"", "]"}], "]"}]}], 
   "]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<R\.b2 = \>\"", ",", 
    RowBox[{"NumberForm", "[", 
     RowBox[{"linFit", "[", "\"\<RSquared\>\"", "]"}], "]"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Global RMSE: \>\"", ",", "rmseAll"}], "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{"\"\<Off-ribbon RMSE: \>\"", ",", "rmseOff"}], "]"}], 
  ";"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.972168797239574*^9, 3.972168811845887*^9}, {
   3.9721689530182333`*^9, 3.972168962354341*^9}, {3.972429671149873*^9, 
   3.972429689765871*^9}, {3.972429720167349*^9, 3.972429721142914*^9}, {
